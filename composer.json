{
    "name": "nowo-tech/php-quality-tools",
    "description": "Pre-configured quality tools for PHP projects (Rector, PHP-CS-Fixer, Twig-CS-Fixer) with automatic framework detection, plus CI gate scripts (Clover coverage threshold, module boundaries, latest-release-tag deploy guard), a PHPUnit SQL query-budget trait, ParaTest per-process isolation helpers, profiler-based route query scaling and missing-translation test traits, front-end / docs gates (no inline SVG, Vite asset budgets, Markdown links) and AI agent co-author trailer checks / hooks.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "rector",
        "php-cs-fixer",
        "twig-cs-fixer",
        "quality",
        "code-style",
        "refactoring",
        "symfony",
        "laravel",
        "php",
        "composer-plugin",
        "psr-12",
        "coverage",
        "module-boundaries",
        "query-budget",
        "release",
        "deploy-guard",
        "paratest",
        "vite",
        "asset-budget",
        "markdown-links",
        "svg"
    ],
    "homepage": "https://github.com/nowo-tech/PhpQualityTools",
    "support": {
        "issues": "https://github.com/nowo-tech/PhpQualityTools/issues",
        "source": "https://github.com/nowo-tech/PhpQualityTools"
    },
    "authors": [
        {
            "name": "H\u00e9ctor Franco Aceituno",
            "email": "hectorfranco@nowo.com",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "doctrine/dbal": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "igor-php/igor-php": "^0.10.0",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "rector/rector": "^2.7",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.0 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "suggest": {
        "rector/rector": "For automated code refactoring",
        "rector/rector-symfony": "Rector rules for Symfony projects",
        "rector/rector-doctrine": "Rector rules for Doctrine",
        "rector/rector-phpunit": "Rector rules for PHPUnit",
        "driftingly/rector-laravel": "Rector rules for Laravel projects",
        "friendsofphp/php-cs-fixer": "For code style fixing",
        "vincentlanglet/twig-cs-fixer": "For Twig template style fixing",
        "symplify/rule-doc-generator-contracts": "Required for custom Rector rules (SplitLongGroupedImportsRector, SplitLongConstructorParametersRector)",
        "symfony/yaml": "Read config/quality/module-boundaries.yaml in bin/check-module-boundaries and config/quality/asset-budgets.yaml in bin/check-asset-budgets (a PHP or JSON config file works without it)",
        "doctrine/dbal": "(^4.0) Count SQL statements with Testing\\Dbal\\QueryCountingMiddleware for Testing\\QueryBudgetTrait",
        "phpunit/phpunit": "Testing\\QueryBudgetTrait assertions (assertQueryBudget, assertScalesWith)",
        "symfony/dependency-injection": "Register Testing\\Env\\PidPathEnvVarProcessor (env var processor pid_path) for per-process test paths under ParaTest",
        "symfony/browser-kit": "Testing\\RouteQueryScalingTrait and Testing\\MissingTranslationsTrait (KernelBrowser + profiler)",
        "symfony/translation": "Testing\\MissingTranslationsTrait (profiler translation collector)",
        "brianium/paratest": "Run PHPUnit (and coverage) in parallel; isolate per-process state with pid_path and bin/clean-stale-pid-paths"
    },
    "autoload": {
        "psr-4": {
            "NowoTech\\PhpQualityTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NowoTech\\PhpQualityTools\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/assert-latest-tag",
        "bin/assert-release-proof",
        "bin/check-asset-budgets",
        "bin/check-coverage-threshold",
        "bin/check-doc-links",
        "bin/check-module-boundaries",
        "bin/check-no-agent-coauthor",
        "bin/check-no-inline-svg",
        "bin/clean-stale-pid-paths",
        "bin/install-git-hooks",
        "bin/strip-agent-coauthor"
    ],
    "extra": {
        "class": "NowoTech\\PhpQualityTools\\Plugin",
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "qa": [
            "@cs-check",
            "@test"
        ],
        "igor": "igor-php --no-agent ."
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactoring",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis",
        "qa": "Run all quality assurance checks",
        "igor": "Run Igor FrankenPHP worker-state audit (REQ-CS-008)"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
