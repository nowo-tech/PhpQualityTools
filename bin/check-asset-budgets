#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Fail when a Vite entry grows past its JS / CSS size budget.
 * See docs/USAGE.md ("Front-end and docs gates") or run with --help.
 */

use NowoTech\PhpQualityTools\Gate\Assets\AssetBudgetCommand;

require __DIR__ . '/autoload.php';

exit((new AssetBudgetCommand(\STDOUT, \STDERR, (string) getcwd()))->run(array_slice($argv, 1)));
