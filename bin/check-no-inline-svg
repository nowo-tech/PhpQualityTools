#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Fail on inline <svg> in templates and SVG markup strings in front-end scripts.
 * See docs/USAGE.md ("Front-end and docs gates") or run with --help.
 */

use NowoTech\PhpQualityTools\Gate\Svg\NoInlineSvgCommand;

require __DIR__ . '/autoload.php';

exit((new NoInlineSvgCommand(\STDOUT, \STDERR, (string) getcwd()))->run(array_slice($argv, 1)));
