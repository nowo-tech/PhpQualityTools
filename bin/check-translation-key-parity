#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Fail when translation catalogues do not share the same keys.
 * See docs/USAGE.md ("Bundle repository checks") or run with --help.
 */

use NowoTech\PhpQualityTools\Gate\Translation\KeyParityCommand;

require __DIR__ . '/autoload.php';

exit((new KeyParityCommand(\STDOUT, \STDERR, (string) getcwd()))->run(array_slice($argv, 1)));
